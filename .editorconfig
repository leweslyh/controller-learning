# ============================================================
# 控制理论模拟器 V5.0 · 编辑器统一约定
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,toml}]
indent_size = 2
