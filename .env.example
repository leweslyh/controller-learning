# ============================================================
# 控制理论模拟器 V5.0 · 环境变量示例（复制为 .env 使用，勿提交真实值）
# ------------------------------------------------------------
# Netlify：Site configuration → Environment variables 添加同名变量
# 本地预览：PowerShell 里 $env:DEEPSEEK_API_KEY="sk-..." 后再启动
# ============================================================

# 服务端 DeepSeek API Key（可选）。前端也可由使用者在助手设置里自填。
DEEPSEEK_API_KEY=

# 可选：自定义上游地址（默认官方 https://api.deepseek.com）
DEEPSEEK_BASE_URL=https://api.deepseek.com
